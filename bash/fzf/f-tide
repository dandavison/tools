#!/bin/bash
# Pick any wormhole project, switch to it via wormhole (opening it if needed),
# and go to one of its tide views (files, search, git, home), as the tide key
# bindings do from inside the project.

view="$1"

main() {
    local project window
    project="$(projects | fzf)"
    [ -n "$project" ] || exit
    # Switch project via wormhole first so that the project's window, not the
    # window the popup was opened from, is tmux's last window when the view
    # window closes.
    wormhole open "$project" --land-in terminal || exit
    window="$(project_window "$project")"
    tmux run-shell -b -t "$window" \
        "$HOME/.local/bin/tide $view '#{window_name}' '#{@project}' '#{@view}' '#{pane_current_path}' '#{session_name}'"
}

# The projects and tasks wormhole is tracking, then every other repo it could
# open.
projects() {
    {
        wormhole project list --name-only
        wormhole project list --available --name-only
    } | awk '!seen[$0]++'
}

# A project's own window is the one carrying no @view. Target it by window id:
# project names contain ':', which tmux would parse as session:window.
project_window() {
    tmux list-windows -a -F '#{window_id}' \
        -f "#{&&:#{==:#{@project},$1},#{==:#{@view},}}"
}

main
