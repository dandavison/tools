#!/bin/bash

# Get the absolute path to this script
SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
# If we still don't have an absolute path, try to construct it
if [[ ! "$SCRIPT_PATH" = /* ]]; then
    SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
fi

# Parse arguments: options until first non-option (pattern), then paths
pattern=""
paths=()
rg_opts=""

# Handle our custom --real-code-only first
if [[ "$1" == "--real-code-only" ]]; then
    rg_opts=' -g "!*.md" -g "!*_test*" -g "!*test_*" -g "!*mock*" -g "!openapiv*" -g "!*_gen.go" -g "!*_pb.go"'
    shift
fi

# Check if we're in command mode (special flag)
MODE="pattern"
if [[ "$1" == "--f-rg-command-mode" ]]; then
    MODE="command"
    shift
fi

# Collect any leading options
while [[ $# -gt 0 && "$1" =~ ^- ]]; do
    opt="$1"
    rg_opts+=" $opt"
    shift
    # Handle options that need an argument
    case "$opt" in
        -g|--glob|-t|--type|-e|--regexp)
            if [[ $# -gt 0 ]]; then
                # Preserve quotes for glob patterns
                rg_opts+=" '$1'"
                shift
            fi
            ;;
    esac
done

# Next argument is the pattern
if [[ $# -gt 0 ]]; then
    pattern="$1"
    shift
fi

# Remaining arguments are paths
while [[ $# -gt 0 ]]; do
    paths+=("$1")
    shift
done

# Default to current directory if no paths specified
if [[ ${#paths[@]} -eq 0 ]]; then
    paths=(".")
fi

rg_args="--follow -i --hidden -g '!.git/*'$rg_opts"
RG="rg $rg_args --color=always"
if [ -f .rg-config ]; then
    RG="RIPGREP_CONFIG_PATH=.rg-config $RG"
fi

DELTA="delta --light --grep-output-type classic"

fzf() {
    command fzf \
        --layout reverse \
        --info hidden \
        --prompt ' ' \
        --color light \
        --ansi \
        --bind 'ctrl-k:kill-line' \
        --bind 'alt-right:forward-word' \
        --bind 'alt-left:backward-word' \
        --preview-window 'up,70%' \
        "$@"
}

initial_command() {
    if [[ -n "$1" ]]; then
        $RG --json "$1" "${paths[@]}" 2>/dev/null
    fi
}

if [[ "$MODE" == "command" ]]; then
    # Command mode - the query IS the full rg command

    # Build the initial command to show in query
    initial_query="rg --follow -i --hidden -g \"!.git/*\"$rg_opts --json \"$pattern\" ${paths[*]}"

    # Show the same initial results as pattern mode would have  
    echo "" |
    fzf -d: \
        --query="$initial_query" \
        --phony \
        --bind='start:reload:'"$RG"' --json "'"$pattern"'" '"${paths[*]}"' 2>/dev/null | '"$DELTA"' \
        --bind='change:reload:
            cmd="{q}"
            # Add --json if not present and pipe to delta
            if [[ "$cmd" != *"--json"* ]]; then
                cmd="${cmd/rg /rg --json }"
            fi
            # Execute the command
            eval "$cmd" 2>/dev/null | '"$DELTA"'
        ' \
        --bind='tab:execute:
                # Switch back to pattern mode - extract pattern from command
                cmd="{q}"
                # Simple extraction - just grab the word after --json
                PATTERN=$(echo "$cmd" | awk "{for(i=1;i<=NF;i++) if(\$i==\"--json\") {print \$(i+1); exit}}")
                # Remove quotes if present
                PATTERN="${PATTERN%\"}"
                PATTERN="${PATTERN#\"}"
                [[ -z "$PATTERN" ]] && PATTERN=""

                # Exec back to pattern mode with the same paths
                exec '"$SCRIPT_PATH"' "$PATTERN" '"${paths[*]}"'
            ' \
        --bind='enter:execute:wormhole {1}:{2}' \
        --header='Command Mode' \
        --preview="[[ -n {1} ]] && f-rg-preview {1} {2}"
else
    # Pattern mode - the query is just the search pattern

    # We need to use reload to show initial results with --phony
    echo "" |
        fzf -d: \
            --query="$pattern" \
            --phony \
            --bind='start:reload:'"$RG"' --json "'"$pattern"'" '"${paths[*]}"' 2>/dev/null | '"$DELTA"' \
            --bind='change:reload:
            # Use the pattern in the standard command
            '"$RG"' --json {q} '"${paths[*]}"' 2>/dev/null | '"$DELTA"'
            ' \
            --bind='tab:execute:
                # Switch to command mode with current pattern (remove any quotes from {q})
                PATTERN="{q}"
                # Remove surrounding quotes if present
                PATTERN="${PATTERN%'"'"'}"
                PATTERN="${PATTERN#'"'"'}"
                PATTERN="${PATTERN%\"}"
                PATTERN="${PATTERN#\"}"
                exec '"$SCRIPT_PATH"' --f-rg-command-mode "$PATTERN" '"${paths[*]}"'
            ' \
        --bind='enter:execute:wormhole {1}:{2}' \
        --header='rg --follow -i --hidden -g "!.git/*"'"$rg_opts"' --json {q} '"${paths[*]}" \
        --preview="[[ -n {1} ]] && f-rg-preview {1} {2}"
fi