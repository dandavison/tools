#!/usr/bin/env bash
#
# agent-oneshot [--personal] [MODEL]
#
# Choose a model (agent-pick), read a prompt from stdin/terminal, then run it one-shot.
set -euo pipefail

main() {
    local pick cli model prompt
    pick="$(agent-pick "$@")"
    cli=$(jq -r .cli <<<"$pick")
    model=$(jq -r .model <<<"$pick")
    while IFS= read -r kv; do export "$kv"; done < <(jq -r '.env | to_entries[] | "\(.key)=\(.value)"' <<<"$pick")
    prompt="$(rlwrap cat)"
    case "$cli" in
        claude) claude_oneshot "$model" "$prompt" ;;
        codex) codex_oneshot "$model" "$prompt" "$(jq -c .price <<<"$pick")" ;;
        pi) pi --model "$model" --print --no-session "$prompt" ;;
    esac
}

claude_oneshot() {
    local model=$1 prompt=$2 rc
    set +e
    claude --model "$model" --print --no-session-persistence --output-format stream-json --verbose "$prompt" |
      jq -nj --unbuffered '
          foreach inputs as $e (
            {last: null, out: ""};
            reduce (
              if $e.type == "assistant" then
                ( $e.message.content[]? |
                  if   .type == "text"     then {k: "text", v: .text}
                  elif .type == "tool_use" then {k: "tool", v: (if .name == "Skill" then "Skill(\(.input.skill))" else .name end)}
                  else empty end )
              elif $e.type == "result" then
                {k: "result", v: "\($e.subtype), \($e.num_turns) turns, $\($e.total_cost_usd // 0 | .*10000|round/10000)"}
              else empty end
            ) as $it (
              {last: .last, out: ""};
              if $it.k == "tool" then
                if .last == $it.v
                then {last: .last, out: (.out + "[2m·[0m")}
                else {last: $it.v, out: (.out + "\n[2m[tool: \($it.v)][0m")}
                end
              elif $it.k == "text" then
                {last: null, out: (.out + (if .last != null then "\n" else "" end) + $it.v)}
              else
                {last: null, out: (.out + "\n\n[2m--- done: \($it.v) ---[0m\n")}
              end
            );
            .out
          )
        '
    rc=${PIPESTATUS[0]}
    set -e
    return "$rc"
}

# Codex logs to stderr; its errors also appear as events in the JSON stream.
codex_oneshot() {
    local model=$1 prompt=$2 price=$3 rc
    set +e
    codex exec --model "$model" --skip-git-repo-check --ephemeral --json "$prompt" 2>/dev/null </dev/null |
        jq -rj --unbuffered --argjson price "$price" '
            def cost:
                (.input_tokens - .cached_input_tokens - .cache_write_input_tokens) * $price.input
                + .cached_input_tokens * $price.cached_input
                + .cache_write_input_tokens * $price.cache_write
                + .output_tokens * $price.output
                | ./1e6 * 10000 | round / 10000;
            if .type == "item.completed" and .item.type == "agent_message" then "\(.item.text)\n"
            elif .type == "item.completed" and .item.type == "error" then "\u001b[2m[error: \(.item.message)]\u001b[0m\n"
            elif .type == "item.started" then "\u001b[2m[tool: \(.item.type)]\u001b[0m\n"
            elif .type == "turn.failed" then "\u001b[2m--- failed: \(.error.message) ---\u001b[0m\n"
            elif .type == "turn.completed" then "\n\u001b[2m--- done: \(if $price then "$\(.usage | cost)" else "\(.usage.input_tokens + .usage.output_tokens) tokens" end) ---\u001b[0m\n"
            else empty end
        '
    rc=${PIPESTATUS[0]}
    set -e
    return "$rc"
}

main "$@"
