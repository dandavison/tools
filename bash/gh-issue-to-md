#!/bin/bash

set -e

usage() {
    echo "Usage: gh-issue-to-md [-r|--reverse] [--last N] [--gte|--gt|--lte|--lt H1] <issue-number-or-url>" >&2
    echo "H1 bounds compare comments' first-line H1 as strings; comments without one are excluded." >&2
    exit 1
}

reverse=false
url=""
last="" gte="" gt="" lte="" lt=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--reverse) reverse=true ;;
        --last|--gte|--gt|--lte|--lt)
            [[ $# -ge 2 ]] || usage
            printf -v "${1#--}" '%s' "$2"
            shift
            ;;
        -*) usage ;;
        *) url="$1" ;;
    esac
    shift
done
[[ -n "$url" ]] || usage
jq_args=(--argjson reverse "$reverse" --arg last "$last"
    --arg gte "$gte" --arg gt "$gt" --arg lte "$lte" --arg lt "$lt")

# Accept bare issue numbers defaulting to temporalio/dandavison-log
if [[ "$url" =~ ^[0-9]+$ ]]; then
    url="https://github.com/temporalio/dandavison-log/issues/$url"
fi

# Parse GitHub issue URL
# Supports: https://github.com/owner/repo/issues/123
if [[ "$url" =~ github\.com/([^/]+)/([^/]+)/issues/([0-9]+) ]]; then
    owner="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[2]}"
    issue_number="${BASH_REMATCH[3]}"
else
    echo "Error: Invalid GitHub issue URL" >&2
    echo "Expected format: https://github.com/owner/repo/issues/123" >&2
    exit 1
fi

api_path="/repos/$owner/$repo/issues/$issue_number"

# Fetch issue details
issue=$(gh api "$api_path")
title=$(echo "$issue" | jq -r '.title')
title_yaml=$(echo "$issue" | jq '.title')
body=$(echo "$issue" | jq -r '.body // ""')
created_at=$(echo "$issue" | jq -r '.created_at')
date="${created_at%%T*}"

# Frontmatter
echo "---"
echo "number: $issue_number"
echo "url: https://github.com/$owner/$repo/issues/$issue_number"
echo "date: $date"
echo "title: $title_yaml"
echo "---"
echo

# Output issue title and body
echo "# $title"
echo
if [[ -n "$body" && "$body" != "null" ]]; then
    echo "$body"
    echo
fi

# Fetch and output comments
comments=$(gh api "$api_path/comments" --paginate | jq -s "${jq_args[@]}" '
    def h1: (.body // "") | (capture("^# (?<h>[^\r\n]*)").h // null);
    def in_bounds($h):
        [$gte, $gt, $lte, $lt] == ["", "", "", ""]
        or ($h != null
            and ($gte == "" or $h >= $gte) and ($gt == "" or $h > $gt)
            and ($lte == "" or $h <= $lte) and ($lt == "" or $h < $lt));
    add
    | map(select(in_bounds(h1)))
    | if $last == "" then . else .[-($last | tonumber):] end
    | if $reverse then reverse else . end
')
comment_count=$(echo "$comments" | jq 'length')

if [[ "$comment_count" -gt 0 ]]; then
    echo "---"
    echo
    echo "## Comments"
    echo

    echo "$comments" | jq -c '.[]' | while read -r comment; do
        comment_author=$(echo "$comment" | jq -r '.user.login')
        comment_created=$(echo "$comment" | jq -r '.created_at')
        comment_body=$(echo "$comment" | jq -r '.body // ""')

        echo "### @$comment_author on $comment_created"
        echo
        if [[ -n "$comment_body" && "$comment_body" != "null" ]]; then
            echo "$comment_body"
        fi
        echo
    done
fi









