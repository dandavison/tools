#!/bin/bash
#
# agent-with-input [-- <agent> [<arg>...]]
#
# Start an interactive agent session (default: claude) with the input buffer
# pre-seeded with stdin, delivered as a bracketed paste so the agent UI
# collapses it to a placeholder. A "--" separator line is appended and the
# cursor is left after it. Nothing is submitted.
#
# Requires tmux: the agent takes over this pane and a background helper types
# into it via tmux send-keys / paste-buffer.

set -euo pipefail

agent=(claude)
if [[ ${1:-} == "--" ]]; then
    shift
    if [[ $# -gt 0 ]]; then agent=("$@"); fi
elif [[ $# -gt 0 ]]; then
    echo "Usage: agent-with-input [-- <agent> [<arg>...]]" >&2
    exit 1
fi

if [[ -z "${TMUX:-}" ]]; then
    echo "Error: agent-with-input must be run inside tmux" >&2
    exit 1
fi

if [[ -t 0 ]]; then
    echo "Error: agent-with-input expects input on stdin" >&2
    exit 1
fi

pane="$TMUX_PANE"
buffer="agent-with-input-$$"
tmux load-buffer -b "$buffer" -

send_newline() {
    tmux send-keys -t "$pane" C-j  # ctrl-j inserts a newline without submitting (claude, codex)
}

(
    # Wait for the agent UI to render in the pane.
    if [[ "${agent[0]}" == claude ]]; then
        for _ in $(seq 30); do
            if tmux capture-pane -t "$pane" -p | grep -qE 'Claude Code|shortcuts'; then
                break
            fi
            sleep 0.5
        done
        sleep 1.5
    else
        sleep 3
    fi

    tmux paste-buffer -p -d -b "$buffer" -t "$pane"
    sleep 0.3
    send_newline
    send_newline
    tmux send-keys -t "$pane" -l -- "--"
    send_newline
    send_newline
) &

# Give the agent the pane's terminal as stdin, replacing our input pipe. It
# must be the pty device itself: Bun-based agents (claude) fail with
# "EINVAL: invalid argument, kqueue" when stdin is /dev/tty.
exec < "$(tmux display-message -p -t "$pane" '#{pane_tty}')"
exec "${agent[@]}"
