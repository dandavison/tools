#!/bin/bash
# tmux popups (and bind-key) inherit a stripped PATH, so make the picker's tools
# reachable regardless of how this is launched.
export PATH="$HOME/bin:/opt/homebrew/bin:$PATH"

extra_apps=(
    "/System/Applications/System Settings.app"
)

pick() {
    local app
    app="$(
        { command fd -d 1 '.+\.app' /Applications ~/Applications/Chrome\ Apps.localized/
          printf '%s\n' "${extra_apps[@]}"
        } |
        rg -r '$2$1' '^(.*/([^/]+)\.app)/?$' |
        fzf --with-nth 1 -d / |
        sed -E 's,[^/]+/,/,')"
    [ -n "$app" ] && DELTA_FEATURES="" open "$app"
}

pick
