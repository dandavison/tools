#!/bin/bash
#
# agent-from-issues [-R owner/repo] <issue-number>... [-- <agent> [<arg>...]]
#
# Start an interactive agent session (default: claude) with the input buffer
# pre-seeded with the content of the given GitHub issues (fetched via
# gh-issue-to-md). Each issue's content is delivered as a bracketed paste so
# the agent UI collapses it to a placeholder. Nothing is submitted; the cursor
# is left at the end of the seeded prompt.
#
# Requires tmux: the agent takes over this pane and a background helper types
# into it via tmux send-keys / paste-buffer.

set -euo pipefail

repo=dandavison/log
if [[ "${1:-}" == "-R" ]]; then
    repo="$2"
    shift 2
fi

issues=()
agent=(claude)
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--" ]]; then
        shift
        if [[ $# -gt 0 ]]; then agent=("$@"); fi
        break
    fi
    issues+=("$1")
    shift
done

if [[ ${#issues[@]} -eq 0 ]]; then
    echo "Usage: agent-from-issues [-R owner/repo] <issue-number>... [-- <agent> [<arg>...]]" >&2
    exit 1
fi

if [[ -z "${TMUX:-}" ]]; then
    echo "Error: agent-from-issues must be run inside tmux" >&2
    exit 1
fi

pane="$TMUX_PANE"
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

for n in "${issues[@]}"; do
    gh-issue-to-md "https://github.com/$repo/issues/$n" > "$tmpdir/$n.md"
done

send_newline() {
    tmux send-keys -t "$pane" C-j  # ctrl-j inserts a newline without submitting (claude, codex)
}

(
    # Wait for the agent UI to render in the pane.
    if [[ "${agent[0]}" == claude ]]; then
        for _ in $(seq 30); do
            if tmux capture-pane -t "$pane" -p | grep -qE 'Claude Code|shortcuts'; then
                break
            fi
            sleep 0.5
        done
        sleep 1.5
    else
        sleep 3
    fi

    for n in "${issues[@]}"; do
        tmux send-keys -t "$pane" -l "Here is the content of issue #$n from my log repo:"
        send_newline
        tmux load-buffer -b agent-from-issues "$tmpdir/$n.md"
        tmux paste-buffer -p -d -b agent-from-issues -t "$pane"
        sleep 0.3
        send_newline
        send_newline
    done
    rm -rf "$tmpdir"
) &

trap - EXIT
exec "${agent[@]}"
