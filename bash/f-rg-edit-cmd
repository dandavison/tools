#!/bin/bash

# Minimal command editor for f-rg
CMD_FILE="$1"

if [[ ! -f "$CMD_FILE" ]]; then
    echo "Error: Command file not found" >&2
    exit 1
fi

current_cmd=$(cat "$CMD_FILE")

clear
echo "Edit command ({q} = search pattern):"
echo
echo "$current_cmd"
echo
echo "(Press ↑ to edit current, Enter to keep, or type new)"

# Add current command to history so up arrow works
history -s "$current_cmd" 2>/dev/null
read -e -p "> " new_cmd

# If empty, keep current
if [[ -z "$new_cmd" ]]; then
    new_cmd="$current_cmd"
fi

if [[ "$new_cmd" != "$current_cmd" ]]; then
    echo "$new_cmd" > "$CMD_FILE"
    echo
    echo "Updated."
fi
