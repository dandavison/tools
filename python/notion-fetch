#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = ["pycookiecheat>=0.8"]
# ///
"""Export a Notion page to Markdown on stdout, with no LLM in the loop.

Reads your Chrome `token_v2` session cookie (via pycookiecheat), drives Notion's
private export API (enqueueTask/getTasks), downloads the resulting zip, and
prints its Markdown. This is Notion's own high-fidelity export, identical to the
"Export" menu item.

Usage:
  notion-fetch <notion-url> [--recursive] [--profile "Profile 1"]

Notion's export omits comments, so the page's comment threads are fetched
separately from the private record API and appended.

Requires being logged into Notion in Chrome. The first run triggers a one-time
macOS Keychain prompt for "Chrome Safe Storage"; click "Always Allow".
"""

import argparse
import csv
import datetime
import io
import json
import os
import posixpath
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from collections import defaultdict
from pathlib import Path
from typing import Any, NoReturn

from pycookiecheat import chrome_cookies

API = "https://www.notion.so/api/v3"
UUID_RE = re.compile(
    r"[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}", re.I
)


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Export a Notion page to Markdown on stdout."
    )
    ap.add_argument("url", help="Notion page URL")
    ap.add_argument("--recursive", action="store_true", help="include subpages")
    ap.add_argument(
        "--profile", help='Chrome profile, e.g. "Profile 1" (default: Default)'
    )
    ap.add_argument("--timeout", type=int, default=180, help="export wait, seconds")
    args = ap.parse_args()

    block_id = extract_block_id(args.url)
    cookies = notion_cookies(args.profile)
    token = cookies["token_v2"]

    task_id = enqueue_export(block_id, token, args.recursive)
    log(f"export task {task_id} enqueued for block {block_id}")
    export_url = poll_export(task_id, token, args.timeout)
    log(f"downloading {export_url}")
    sys.stdout.write(markdown_from_zip(download(export_url, cookies)))
    sys.stdout.write(comments_markdown(block_id, token))
    return 0


def extract_block_id(url: str) -> str:
    # Drop any #block anchor so we export the page, not the anchored sub-block.
    ids = UUID_RE.findall(url.split("#", 1)[0])
    if not ids:
        die(f"no page id found in URL: {url}")
    raw = ids[-1].replace("-", "").lower()
    return f"{raw[0:8]}-{raw[8:12]}-{raw[12:16]}-{raw[16:20]}-{raw[20:32]}"


def notion_cookies(profile: str | None) -> dict[str, str]:
    cookie_file = None
    if profile:
        cookie_file = (
            Path.home()
            / "Library/Application Support/Google/Chrome"
            / profile
            / "Cookies"
        )
    cookies = chrome_cookies("https://www.notion.so", cookie_file=cookie_file)
    if not cookies.get("token_v2"):
        die(
            "no token_v2 cookie for www.notion.so; log into Notion in Chrome"
            + (f" ({profile})" if profile else "")
        )
    return cookies


def enqueue_export(block_id: str, token: str, recursive: bool) -> str:
    body = {
        "task": {
            "eventName": "exportBlock",
            "request": {
                "block": {"id": block_id},
                "recursive": recursive,
                "exportOptions": {
                    "exportType": "markdown",
                    "timeZone": local_timezone(),
                    "locale": "en",
                },
            },
        }
    }
    return api_post("enqueueTask", body, token)["taskId"]


def poll_export(task_id: str, token: str, timeout_s: int) -> str:
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        results = (
            api_post("getTasks", {"taskIds": [task_id]}, token).get("results") or []
        )
        if not results:
            die(f"task {task_id} not found")
        task = results[0]
        state = task.get("state")
        if state == "success":
            return task["status"]["exportURL"]
        if state == "failure":
            die(f"export failed: {json.dumps(task.get('error') or task.get('status'))}")
        status = task.get("status") or {}
        log(f"  state={state} pagesExported={status.get('pagesExported')}")
        time.sleep(2)
    die(f"export timed out after {timeout_s}s")


def download(url: str, cookies: dict[str, str]) -> bytes:
    header = "; ".join(f"{k}={v}" for k, v in cookies.items())
    req = urllib.request.Request(url, headers={"Cookie": header})
    with urllib.request.urlopen(req, timeout=120) as resp:
        return resp.read()


def markdown_from_zip(data: bytes) -> str:
    zf = zipfile.ZipFile(io.BytesIO(data))
    names = sorted(n for n in zf.namelist() if n.lower().endswith(".md"))
    if not names:
        die(f"no markdown in export zip (entries: {zf.namelist()[:10]})")
    docs = [fold_table_rows(inline_databases(zf, n)) for n in names]
    if len(docs) == 1:
        return docs[0]
    return "\n\n\n".join(f"<!-- {n} -->\n\n{d}" for n, d in zip(names, docs))


def inline_databases(zf: zipfile.ZipFile, md_name: str) -> str:
    """Notion exports each database as a sibling CSV that the Markdown merely
    links to; splice the rows in at the link site so the export stands alone."""

    def splice(match: re.Match[str]) -> str:
        title, href = match.group(1), match.group(2)
        path = posixpath.normpath(
            posixpath.join(posixpath.dirname(md_name), urllib.parse.unquote(href))
        )
        rows = list(csv.reader(io.StringIO(zf.read(path).decode("utf-8-sig"))))
        heading = f"### {title}\n\n" if title and title != "Untitled" else ""
        return heading + render_rows(rows)

    md = zf.read(md_name).decode("utf-8")
    return re.sub(r"\[([^\]]*)\]\(([^)]+\.csv)\)", splice, md)


def fold_table_rows(md: str) -> str:
    """A table cell holding several Notion blocks is exported across several
    physical lines, which breaks the pipe-table syntax; fold each row back onto
    one line, keeping the block breaks as ``<br>``."""
    out: list[str] = []
    row: list[str] | None = None
    fenced = False
    for line in md.split("\n"):
        if row is not None:
            row.append(line)
            if line.rstrip().endswith("|"):
                out.append("<br>".join(row))
                row = None
        elif not fenced and line.startswith("|") and not line.rstrip().endswith("|"):
            row = [line]
        else:
            fenced ^= line.lstrip().startswith("```")
            out.append(line)
    if row is not None:
        out.append("<br>".join(row))
    return "\n".join(out)


def render_rows(rows: list[list[str]]) -> str:
    """Render database rows as titled field lists. Notion databases are wide and
    prose-filled, which Markdown tables render unreadably."""
    if not rows:
        return ""
    header, body = rows[0], rows[1:]
    out: list[str] = []
    for row in body:
        title = row[0].strip() if row else ""
        fields = [(h, v.strip()) for h, v in zip(header[1:], row[1:]) if v.strip()]
        if not title and not fields:
            continue
        if title:
            out.append(f"**{one_line(title)}**")
        out.extend(f"- **{h}**: {indented(v)}" for h, v in fields)
        out.append("")
    return "\n".join(out)


def one_line(value: str) -> str:
    return re.sub(r"\s*\n\s*", " ", value.strip())


def indented(value: str) -> str:
    """Cell text spanning several Notion blocks becomes indented paragraphs so it
    stays inside its bullet."""
    return "\n\n  ".join(line.strip() for line in value.splitlines() if line.strip())


def comments_markdown(page_id: str, token: str) -> str:
    """Notion's export omits comments; fetch them from the private record API.

    Page chunks return ``comment``, ``discussion``, and ``notion_user`` records
    inline. A comment's ``parent_id`` is its discussion; a discussion's
    ``parent_id`` is the block it annotates (or the page itself).
    """
    records = load_page_records(page_id, token)
    comments = records.get("comment", {})
    if not comments:
        log("no comments found")
        return ""
    order = block_order(records.get("block", {}), page_id)
    return render_comments(
        order, records.get("discussion", {}), comments, records.get("notion_user", {})
    )


def render_comments(
    order: list[str],
    discussions: dict[str, Any],
    comments: dict[str, Any],
    users: dict[str, Any],
) -> str:
    position = {bid: i for i, bid in enumerate(order)}
    threads: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for c in comments.values():
        if c.get("alive") is not False:
            threads[c.get("parent_id")].append(c)

    def thread_key(discussion_id: str) -> tuple[int, str]:
        anchor = (discussions.get(discussion_id) or {}).get("parent_id")
        return position.get(anchor, len(order)), discussion_id

    out = ["", "## Comments", ""]
    for did in sorted(threads, key=thread_key):
        disc = discussions.get(did) or {}
        context = rich_text(disc.get("context"), users).strip()
        heading = f'On "{context}"' if context else "Page comment"
        if disc.get("resolved"):
            heading += " _(resolved)_"
        out.append(f"### {heading}")
        for c in sorted(threads[did], key=lambda c: c.get("created_time") or 0):
            author = users.get(c.get("created_by_id") or c.get("created_by")) or {}
            when = fmt_time(c.get("created_time"))
            body = rich_text(c.get("text"), users).strip()
            out.append(
                f"- **{user_name(author)}**{f' ({when})' if when else ''}: {body}"
            )
        out.append("")
    return "\n".join(out) + "\n"


def load_page_records(page_id: str, token: str) -> dict[str, dict[str, Any]]:
    tables: dict[str, dict[str, Any]] = defaultdict(dict)
    cursor: dict[str, Any] = {"stack": []}
    while True:
        resp = api_post(
            "loadPageChunk",
            {
                "pageId": page_id,
                "limit": 100,
                "cursor": cursor,
                "chunkNumber": 0,
                "verticalColumns": False,
            },
            token,
        )
        merge_record_map(tables, resp.get("recordMap"))
        cursor = resp.get("cursor") or {}
        if not cursor.get("stack"):
            break

    requests = descendant_chunk_requests(tables.get("block", {}), page_id)
    if requests:
        resp = api_post("loadCachedPageChunks", {"requests": requests}, token)
        merge_record_map(tables, resp.get("recordMap"))
    return tables


def descendant_chunk_requests(
    blocks: dict[str, Any], root: str
) -> list[dict[str, Any]]:
    return [
        {
            "page": {"id": block_id, "spaceId": blocks[block_id]["space_id"]},
            "cursor": {"stack": []},
            "verticalColumns": False,
        }
        for block_id in block_order(blocks, root)
        if block_id != root and (blocks[block_id].get("format") or {}).get("toggleable")
    ]


def merge_record_map(tables: dict[str, dict[str, Any]], record_map: Any) -> None:
    for table, recs in (record_map or {}).items():
        if not isinstance(recs, dict):
            continue
        for rid, rec in recs.items():
            value = unwrap(rec)
            if value:
                tables[table][rid] = value


def unwrap(rec: Any) -> dict[str, Any] | None:
    """Peel record wrappers ({spaceId/value/role: ...}) down to the record itself,
    which is the first nested dict carrying an ``id``."""
    while (
        isinstance(rec, dict) and "id" not in rec and isinstance(rec.get("value"), dict)
    ):
        rec = rec["value"]
    return rec if isinstance(rec, dict) and "id" in rec else None


def user_name(user: dict[str, Any]) -> str:
    parts = [user.get("given_name"), user.get("family_name")]
    return user.get("name") or " ".join(p for p in parts if p) or "Unknown"


def block_order(blocks: dict[str, Any], root: str) -> list[str]:
    order: list[str] = []
    seen: set[str] = set()
    stack = [root]
    while stack:
        bid = stack.pop()
        if bid in seen or bid not in blocks:
            continue
        seen.add(bid)
        order.append(bid)
        stack.extend(reversed(blocks[bid].get("content") or []))
    return order


def rich_text(rt: Any, users: dict[str, Any]) -> str:
    if not isinstance(rt, list):
        return ""
    parts: list[str] = []
    for seg in rt:
        if not seg:
            continue
        text = seg[0]
        decorations = seg[1] if len(seg) > 1 else []
        mention = next((d for d in decorations if d and d[0] == "u"), None)
        if mention and len(mention) > 1:
            name = users.get(mention[1], {}).get("name")
            parts.append(f"@{name}" if name else text)
        else:
            parts.append(text)
    return "".join(parts)


def fmt_time(ms: Any) -> str:
    try:
        return datetime.datetime.fromtimestamp(int(ms) / 1000).strftime(
            "%Y-%m-%d %H:%M"
        )
    except (TypeError, ValueError, OSError):
        return ""


def api_post(path: str, body: dict[str, Any], token: str) -> dict[str, Any]:
    req = urllib.request.Request(
        f"{API}/{path}",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "Cookie": f"token_v2={token}"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        die(
            f"POST {path} -> {e.code} {e.reason}: {e.read().decode(errors='replace')[:500]}"
        )


def local_timezone() -> str:
    link = Path("/etc/localtime")
    if link.is_symlink():
        target = os.readlink(link)
        if "zoneinfo/" in target:
            return target.split("zoneinfo/", 1)[1]
    return "UTC"


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def die(msg: str) -> NoReturn:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    sys.exit(main())
