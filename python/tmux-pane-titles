#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Set each tmux pane's title to the command running in it.

tmux only records a pane's start command when the pane is created with one; panes
where the command was typed or sent into a shell have an empty pane_start_command.
So the title is derived from the shell's foreground child process instead.
"""

import argparse
import os
import subprocess
from pathlib import Path

HOME = str(Path.home())


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-a", "--all-windows", action="store_true")
    args = parser.parse_args()

    scope = ["-s"] if args.all_windows else ["-t", os.environ["TMUX_PANE"]]
    panes = tmux("list-panes", *scope, "-F", "#{pane_id} #{pane_pid}").splitlines()
    children = child_commands()
    for line in panes:
        pane_id, pane_pid = line.split()
        command = children.get(int(pane_pid))
        tmux("select-pane", "-t", pane_id, "-T", pretty(command) if command else "")


def child_commands() -> dict[int, str]:
    """Map pid -> command line of its first child process."""
    out = subprocess.run(
        ["ps", "-axo", "ppid=,command="], capture_output=True, text=True, check=True
    ).stdout
    commands: dict[int, str] = {}
    for line in out.splitlines():
        ppid, _, command = line.strip().partition(" ")
        commands.setdefault(int(ppid), command.strip())
    return commands


def pretty(command: str) -> str:
    """Drop an interpreter prefix and abbreviate home-relative paths."""
    argv = command.split()
    if len(argv) > 1 and os.path.basename(argv[0]).startswith("python"):
        argv = argv[1:]
        argv[0] = os.path.basename(argv[0])
    return " ".join(argv).replace(HOME, "~")


def tmux(*args: str) -> str:
    return subprocess.run(
        ["tmux", *args], capture_output=True, text=True, check=True
    ).stdout


if __name__ == "__main__":
    main()
