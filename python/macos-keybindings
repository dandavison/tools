#!/usr/bin/env python3
"""Dump every keyboard shortcut macOS itself has registered.

Reads the actual preference stores the system uses, so nothing has to be found
by clicking around System Settings:

    system    System Settings > Keyboard > Keyboard Shortcuts (symbolic hotkeys)
    app       Per-app menu overrides (NSUserKeyEquivalents in every defaults domain)
    services  Services menu shortcuts (pbs)

Two things are deliberately absent, and both matter when hunting a swallowed key:

  * A macOS default that has never been customised is not stored anywhere, so it
    does not appear here. Absence means "never touched", not "not bound".
  * Shortcuts a running app registers privately -- Carbon RegisterEventHotKey or
    an NSEvent global monitor, as used by Karabiner, Hammerspoon, Raycast and
    friends -- live in no preference file and cannot be enumerated at all.

So when a key disappears and nothing listed here claims it, an app-private
global hotkey is what is left to suspect.

Usage:
    macos-keybindings                  # enabled shortcuts, grouped by source
    macos-keybindings --all            # include disabled ones
    macos-keybindings --key space      # only combos matching a substring
    macos-keybindings --json           # machine-readable, for diffing two hosts
"""

from __future__ import annotations  # system python is still 3.9 on a fresh Mac

import argparse
import concurrent.futures
import json
import plistlib
import subprocess
import sys

MODIFIERS = [(1 << 17, "shift"), (1 << 18, "ctrl"), (1 << 19, "opt"), (1 << 20, "cmd")]

# NSUserKeyEquivalents / Services encode modifiers as a prefix on the key.
COCOA_MODIFIERS = {"@": "cmd", "~": "opt", "^": "ctrl", "$": "shift"}

