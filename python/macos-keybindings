    81: "Move right a space",
    98: "Show Help menu",
    184: "Screenshot and recording options",
}


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--all", action="store_true", help="include disabled shortcuts")
    p.add_argument("--key", help="only show combos containing this substring")
    p.add_argument("--json", action="store_true", help="emit JSON")
    args = p.parse_args()

    if sys.platform != "darwin":
        sys.exit("macos-keybindings: macOS only")

    bindings = system_hotkeys() + app_overrides() + service_shortcuts()
    if not args.all:
        bindings = [b for b in bindings if b["enabled"]]
    if args.key:
        bindings = [b for b in bindings if args.key.lower() in b["combo"].lower()]
    bindings.sort(key=lambda b: (b["source"], b["combo"], b["name"]))

    if args.json:
        json.dump(bindings, sys.stdout, indent=2, sort_keys=True)
        print()
    else:
        report(bindings)
    return 0


def system_hotkeys() -> list[dict]:
    hotkeys = (read_domain("com.apple.symbolichotkeys") or {}).get(
        "AppleSymbolicHotKeys", {}
    )
    out = []
    for key, entry in hotkeys.items():
        if not isinstance(entry, dict):
            continue
        params = (entry.get("value") or {}).get("parameters") or []
        out.append(
            {
                "source": "system",
                "name": SYMBOLIC_HOTKEYS.get(int(key), f"unknown (id {key})"),
                "combo": combo_from_parameters(params),
                "enabled": bool(entry.get("enabled")),
                "owner": f"symbolichotkey {key}",
            }
        )
    return out


def app_overrides() -> list[dict]:
    """Per-app menu shortcut overrides, one defaults domain at a time."""
    domains = ["NSGlobalDomain"] + subprocess.run(
        ["defaults", "domains"], capture_output=True, text=True
    ).stdout.strip().split(", ")

    out = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=16) as pool:
        for domain, data in zip(domains, pool.map(read_domain, domains)):
            for menu_item, key in (
                (data or {}).get("NSUserKeyEquivalents") or {}
            ).items():
                out.append(
                    {
                        "source": "app",
                        "name": menu_item,
                        "combo": combo_from_cocoa(key),
                        "enabled": True,
                        "owner": domain,
                    }
                )
    return out


def service_shortcuts() -> list[dict]:
    services = (read_domain("pbs") or {}).get("NSServicesStatus", {}) or {}
    out = []
    for name, status in services.items():
        key = (status or {}).get("key_equivalent")
        if key:
            out.append(
                {
                    "source": "services",
                    "name": name.split(" - ")[-1],
                    "combo": combo_from_cocoa(key),
                    "enabled": True,
                    "owner": "pbs",
                }
            )
    return out


def read_domain(domain: str) -> dict | None:
    r = subprocess.run(["defaults", "export", domain, "-"], capture_output=True)
    if r.returncode != 0 or not r.stdout:
        return None
    try:
        return plistlib.loads(r.stdout)
    except (plistlib.InvalidFileException, ValueError):
        return None


def combo_from_parameters(params: list) -> str:
    """Decode a symbolic hotkey's [char, keycode, modifier-mask] triple."""
    if len(params) < 3:
        return "(none)"
    char, code, mask = params[0], params[1], params[2]
    parts = [name for bit, name in MODIFIERS if isinstance(mask, int) and mask & bit]
    parts.append(key_name(char, code))
    return "+".join(parts)


def key_name(char: int, code: int) -> str:
    if code in KEY_CODES:
        return KEY_CODES[code]
    if isinstance(char, int) and 32 <= char < 0xFFFF:
        return chr(char)
    return f"keycode{code}"


def combo_from_cocoa(key: str) -> str:
    """Decode "@~q" style shortcuts; cmd is implicit in menu equivalents."""
    parts = []
    while key and key[0] in COCOA_MODIFIERS:
        parts.append(COCOA_MODIFIERS[key[0]])
        key = key[1:]
    if "cmd" not in parts:
        parts.append("cmd")
    parts.append(cocoa_key_name(key))
    order = {"ctrl": 0, "opt": 1, "shift": 2, "cmd": 3}
    return "+".join(sorted(parts[:-1], key=lambda m: order.get(m, 9)) + parts[-1:])


def cocoa_key_name(key: str) -> str:
    """Name the key, spelling anything unprintable as a codepoint rather than
    emitting an invisible character (apps such as Chrome use private encodings)."""
    if not key:
        return "(unset)"
    if key in COCOA_KEYS:
        return COCOA_KEYS[key]
    if key.isprintable():
        return key.lower()
    return "+".join(f"U+{ord(c):04X}" for c in key)


def report(bindings: list[dict]) -> None:
    if not bindings:
        print("no matching shortcuts")
        return
    width = max(len(b["combo"]) for b in bindings)
    source = None
    for b in bindings:
        if b["source"] != source:
            source = b["source"]
            print(f"\n{source}")
        state = "" if b["enabled"] else "  [disabled]"
        print(f"  {b['combo']:<{width}}  {b['name']}  ({b['owner']}){state}")


if __name__ == "__main__":
    sys.exit(main())
