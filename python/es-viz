#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Visualize an Elasticsearch/OpenSearch response as a self-contained HTML page.

Reads a JSON response on stdin (or from a file) and picks the chart from the
shape of the data:

  aggregations   an aggregation tree is flattened into a tidy table -- one
                 column per nesting level, one row per leaf bucket -- then
                 charted by column type: time -> columns or line, one category
                 -> horizontal bars, time x category -> stacked columns,
                 category x category -> heatmap, metrics only -> stat tiles.
  hits.hits      a document table, `_source` flattened with dotted names.
  a JSON array   `_cat/*?format=json` output as a table; numeric columns
                 become measures, so they chart too.
  anything else  a key/value panel (`_cluster/health`, `_settings`).

Three or more nesting levels are shown as a table only: a chart of three
dimensions misleads more than it explains. Every chart also ships its table.

Examples:
  ct cell vis query -c s-gc021 --post '{visindex}/_search' -d @agg.json | es-viz

  ct cell vis query -c s-aw024 '_cat/indices?format=json' | es-viz

  es-viz --title 'gc021 scheduled starts' response.json

Times are rendered in UTC, matching what Elasticsearch returns.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from collections.abc import Iterator
from dataclasses import dataclass
from datetime import datetime
from html import escape
from pathlib import Path
from typing import Any, Literal

Kind = Literal["time", "number", "category"]

OTHER = "Other"
SERIES_LIMIT = 8
POINT_LIMIT = 60
CATEGORY_LIMIT = 40
HEATMAP_COLUMN_LIMIT = 60
TABLE_ROW_LIMIT = 500


@dataclass(frozen=True)
class Column:
    name: str
    kind: Kind


@dataclass
class Table:
    name: str
    dims: list[Column]
    measures: list[Column]
    rows: list[dict[str, Any]]


@dataclass
class Document:
    tables: list[Table]
    keyvalues: list[tuple[str, str]]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="es-viz",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "input",
        nargs="?",
        type=Path,
        help="JSON response to read (default: stdin).",
    )
    parser.add_argument("--title", default="Elasticsearch response", help="Page title.")
    parser.add_argument(
        "-o", "--output", type=Path, help="Write HTML here (default: a temp file)."
    )
    parser.add_argument(
        "--no-open", action="store_true", help="Do not open the result in a browser."
    )
    return parser.parse_args()


def parse_input(text: str) -> Any:
    try:
        return json.loads(text)
    except json.JSONDecodeError as error:
        raise SystemExit(
            f"input is not JSON ({error.msg} at line {error.lineno}); "
            "_cat endpoints need format=json rather than v"
        ) from error


# --- response -> tables ------------------------------------------------------


def build_document(response: Any) -> Document:
    if isinstance(response, list):
        return Document(tables=[table_from_records(response)], keyvalues=[])
    if not isinstance(response, dict):
        raise SystemExit("expected a JSON object or array")

    tables: list[Table] = []
    if isinstance(response.get("aggregations"), dict):
        tables.extend(tables_from_aggregations(response["aggregations"]))
    hits = (
        response.get("hits", {}).get("hits")
        if isinstance(response.get("hits"), dict)
        else None
    )
    if hits:
        tables.append(table_from_hits(hits))

    if "hits" in response or "took" in response:
        return Document(tables=tables, keyvalues=search_metadata(response))
    return Document(tables=tables, keyvalues=flat_keyvalues(response))


def search_metadata(response: dict[str, Any]) -> list[tuple[str, str]]:
    out: list[tuple[str, str]] = []
    if "took" in response:
        out.append(("took", f"{response['took']}ms"))
    total = response.get("hits", {}).get("total")
    if isinstance(total, dict):
        prefix = "≥" if total.get("relation") == "gte" else ""
        out.append(("hits.total", f"{prefix}{total.get('value')}"))
    shards = response.get("_shards")
    if isinstance(shards, dict):
        out.append(
            (
                "shards",
                f"{shards.get('successful')}/{shards.get('total')} ok, {shards.get('failed')} failed",
            )
        )
    if response.get("timed_out"):
        out.append(("timed_out", "true"))
    return out


def tables_from_aggregations(aggs: dict[str, Any]) -> list[Table]:
    grouped: dict[tuple[str, ...], list[dict[str, Any]]] = {}
    for path, row in walk_aggs(aggs, (), {}, {}):
        grouped.setdefault(path, []).append(row)
    return [build_table(path, rows) for path, rows in grouped.items()]


def walk_aggs(
    node: dict[str, Any],
    path: tuple[str, ...],
    keys: dict[str, Any],
    measures: dict[str, Any],
) -> Iterator[tuple[tuple[str, ...], dict[str, Any]]]:
    """Yield (agg-name path, row) for every leaf bucket of an aggregation tree."""
    bucket_aggs = [(name, body) for name, body in node.items() if is_bucket_agg(body)]
    measures = {**measures, **metric_measures(node)}
    if not bucket_aggs:
        yield path, {**keys, **measures}
        return
    for name, body in bucket_aggs:
        for label, bucket in bucket_items(body):
            own = {"doc_count": bucket["doc_count"]} if "doc_count" in bucket else {}
            yield from walk_aggs(
                {k: v for k, v in bucket.items() if isinstance(v, dict)},
                path + (name,),
                {**keys, name: label},
                {**measures, **own},
            )


def is_bucket_agg(body: Any) -> bool:
    return isinstance(body, dict) and "buckets" in body


def bucket_items(body: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:
    buckets = body["buckets"]
    if isinstance(buckets, dict):
        return list(buckets.items())
    return [(bucket_label(bucket), bucket) for bucket in buckets]


def bucket_label(bucket: dict[str, Any]) -> str:
    if "key_as_string" in bucket:
        return str(bucket["key_as_string"])
    return str(bucket.get("key"))


def metric_measures(node: dict[str, Any]) -> dict[str, Any]:
    out: dict[str, Any] = {}
    for name, body in node.items():
        if not isinstance(body, dict) or is_bucket_agg(body) or "hits" in body:
            continue
        for leaf, value in flatten_scalars(body):
            leaf = leaf.removeprefix("values.")
            out[name if leaf == "value" else f"{name}.{leaf}"] = value
    return out


def build_table(path: tuple[str, ...], rows: list[dict[str, Any]]) -> Table:
    dims = [Column(name, dim_kind([row[name] for row in rows])) for name in path]
    measures = [
        Column(name, "number")
        for name in dict.fromkeys(key for row in rows for key in row if key not in path)
    ]
    return Table(
        name=" / ".join(path) or "metrics", dims=dims, measures=measures, rows=rows
    )


def table_from_hits(hits: list[dict[str, Any]]) -> Table:
    rows: list[dict[str, Any]] = []
    for hit in hits:
        row: dict[str, Any] = {"_id": hit.get("_id")}
        if hit.get("_score") is not None:
            row["_score"] = hit["_score"]
        row.update(dict(flatten_scalars(hit.get("_source", {}))))
        rows.append(row)
    columns = list(dict.fromkeys(key for row in rows for key in row))
    return Table(
        name="hits",
        dims=[
            Column(name, dim_kind([row.get(name) for row in rows])) for name in columns
        ],
        measures=[],
        rows=rows,
    )


def table_from_records(records: list[Any]) -> Table:
    rows = [
        dict(flatten_scalars(record)) for record in records if isinstance(record, dict)
    ]
    if not rows:
        raise SystemExit("no objects in the JSON array")
    columns = [
        Column(name, dim_kind([row.get(name) for row in rows]))
        for name in dict.fromkeys(key for row in rows for key in row)
    ]
    measures = [column for column in columns if column.kind == "number"]
    for row in rows:
        for column in measures:
            if column.name in row:
                row[column.name] = float(row[column.name])
    return Table(
        name="records",
        dims=[column for column in columns if column.kind != "number"],
        measures=measures,
        rows=rows,
    )


def flatten_scalars(obj: Any, prefix: str = "") -> Iterator[tuple[str, Any]]:
    if isinstance(obj, dict):
        for key, value in obj.items():
            yield from flatten_scalars(value, f"{prefix}{key}.")
    elif isinstance(obj, list):
        yield prefix.rstrip("."), json.dumps(obj)
    else:
        yield prefix.rstrip("."), obj


def flat_keyvalues(obj: dict[str, Any]) -> list[tuple[str, str]]:
    return [(name, format_scalar(value)) for name, value in flatten_scalars(obj)]


def format_scalar(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def dim_kind(values: list[Any]) -> Kind:
    present = [value for value in values if value is not None]
    if not present:
        return "category"
    if all(is_iso_datetime(value) for value in present):
        return "time"
    if all(is_number(value) for value in present):
        return "number"
    return "category"


def is_iso_datetime(value: Any) -> bool:
    if not isinstance(value, str) or "-" not in value:
        return False
    try:
        datetime.fromisoformat(value)
    except ValueError:
        return False
    return True


def is_number(value: Any) -> bool:
    return to_float(value) is not None


def to_float(value: Any) -> float | None:
    if isinstance(value, bool) or not isinstance(value, int | float | str):
        return None
    try:
        return float(value)
    except ValueError:
        return None


# --- table -> chart ----------------------------------------------------------


def chart_form(table: Table) -> str:
    if not table.measures:
        return "table"
    if not table.dims:
        return "tiles"
    if len(table.dims) > 2:
        return "table"
    ordinal = [column for column in table.dims if column.kind in ("time", "number")]
    if len(table.dims) == 1:
        if not ordinal:
            return "bars"
        return "lines" if len(table.rows) > POINT_LIMIT else "columns"
    if not ordinal:
        return "heatmap"
    points = len({row[ordinal[0].name] for row in table.rows})
    return "lines" if points > POINT_LIMIT else "columns"


def ranking(rows: list[dict[str, Any]], dim: str, measure: str) -> list[str]:
    totals: dict[str, float] = {}
    for row in rows:
        totals[row[dim]] = totals.get(row[dim], 0.0) + (
            to_float(row.get(measure)) or 0.0
        )
    return sorted(totals, key=lambda name: -totals[name])


def series_order(table: Table, dim: str, measure: str) -> list[str]:
    ranked = ranking(table.rows, dim, measure)
    if len(ranked) <= SERIES_LIMIT:
        return ranked
    return ranked[: SERIES_LIMIT - 1] + [OTHER]


def fold_rows(
    rows: list[dict[str, Any]], dim: str, keep: set[str], measures: list[str]
) -> list[dict[str, Any]]:
    measure_set = set(measures)
    out: dict[tuple[tuple[str, Any], ...], dict[str, Any]] = {}
    for row in rows:
        folded = dict(row)
        if folded[dim] not in keep:
            folded[dim] = OTHER
        identity = tuple((k, v) for k, v in folded.items() if k not in measure_set)
        target = out.setdefault(identity, dict(identity))
        for name in measure_set:
            value = to_float(folded.get(name))
            if value is not None:
                target[name] = (target.get(name) or 0) + value
    return list(out.values())


def build_card(table: Table) -> dict[str, Any]:
    form = chart_form(table)
    measures = [column.name for column in table.measures]
    rows = table.rows
    notes: list[str] = []
    x_dim = series_dim = None
    series: list[str] = []

    if form == "heatmap":
        # The outer agg's keys are the longer ones, so they go down the y axis
        # where there is room for them.
        series_dim, x_dim = table.dims[0].name, table.dims[1].name
    elif form in ("columns", "lines", "bars"):
        ordinal = [column for column in table.dims if column.kind in ("time", "number")]
        x_dim = (ordinal[0] if ordinal else table.dims[0]).name
        rest = [column.name for column in table.dims if column.name != x_dim]
        series_dim = rest[0] if rest else None

    if series_dim and form == "heatmap":
        series = ranking(rows, series_dim, measures[0])
        if len(series) > CATEGORY_LIMIT:
            notes.append(f"top {CATEGORY_LIMIT} of {len(series)} {series_dim} rows")
            series = series[:CATEGORY_LIMIT]
            rows = [row for row in rows if row[series_dim] in set(series)]
        columns = ranking(rows, str(x_dim), measures[0])
        if len(columns) > HEATMAP_COLUMN_LIMIT:
            notes.append(
                f"top {HEATMAP_COLUMN_LIMIT} of {len(columns)} {x_dim} columns"
            )
            rows = [
                row
                for row in rows
                if row[str(x_dim)] in set(columns[:HEATMAP_COLUMN_LIMIT])
            ]
    elif series_dim:
        series = series_order(table, series_dim, measures[0])
        if OTHER in series:
            notes.append(f"tail of {series_dim} folded into {OTHER} (summed)")
            rows = fold_rows(rows, series_dim, set(series) - {OTHER}, measures)

    if form == "bars":
        ranked = ranking(rows, str(x_dim), measures[0])
        if len(ranked) > CATEGORY_LIMIT:
            notes.append(f"top {CATEGORY_LIMIT} of {len(ranked)} by {measures[0]}")
            rows = [
                row for row in rows if row[str(x_dim)] in set(ranked[:CATEGORY_LIMIT])
            ]

    if any(column.kind == "time" for column in table.dims):
        notes.append("times UTC")
    if len(rows) > TABLE_ROW_LIMIT:
        notes.append(
            f"table view shows the first {TABLE_ROW_LIMIT} of {len(rows)} rows"
        )

    return {
        "name": table.name,
        "form": form,
        "columns": [
            {"name": c.name, "kind": c.kind} for c in table.dims + table.measures
        ],
        "measures": measures,
        "xDim": x_dim,
        "xKind": next((c.kind for c in table.dims if c.name == x_dim), None),
        "seriesDim": series_dim,
        "series": series,
        "rows": rows,
        "note": " · ".join(notes),
    }


# --- HTML --------------------------------------------------------------------


def render_html(document: Document, title: str) -> str:
    payload = {
        "cards": [build_card(table) for table in document.tables],
        "keyvalues": document.keyvalues,
    }
    return (
        HTML_TEMPLATE.replace("__TITLE__", escape(title))
        .replace("__ROW_LIMIT__", str(TABLE_ROW_LIMIT))
        .replace("__PAYLOAD__", json.dumps(payload))
    )


