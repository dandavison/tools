<h1>__TITLE__</h1>
<div class="meta" id="meta"></div>
<div id="cards"></div>
<div class="tip" id="tip"></div>
<script>
const PAYLOAD = __PAYLOAD__;
const ROW_LIMIT = __ROW_LIMIT__;
const NS = "http://www.w3.org/2000/svg";
const W = 1160;
const tip = document.getElementById("tip");

const el = (name, attrs = {}) => {
  const node = document.createElementNS(NS, name);
  for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
  return node;
};
const svgText = (attrs, value) => {
  const node = el("text", {fill: "var(--muted)", "font-size": 11, ...attrs});
  node.textContent = value;
  return node;
};
const html = (tag, cls, value) => {
  const node = document.createElement(tag);
  if (cls) node.className = cls;
  if (value !== undefined) node.textContent = value;
  return node;
};
const seriesColor = i => `var(--series-${(i % 8) + 1})`;

const compact = v => {
  const a = Math.abs(v);
  if (a >= 1e9) return (v / 1e9).toFixed(a >= 1e10 ? 0 : 1) + "B";
  if (a >= 1e6) return (v / 1e6).toFixed(a >= 1e7 ? 0 : 1) + "M";
  if (a >= 1e3) return (v / 1e3).toFixed(a >= 1e4 ? 0 : 1) + "K";
  return Number.isInteger(v) ? String(v) : v.toFixed(2);
};
const axisScale = max => {
  if (!(max > 0)) return {max: 1, step: 0.25};
  const raw = max / 4;
  const mag = Math.pow(10, Math.floor(Math.log10(raw)));
  const step = [1, 2, 2.5, 5, 10].map(m => m * mag).find(s => s >= raw) ?? 10 * mag;
  return {max: Math.ceil(max / step) * step, step};
};
const roundedTop = (x, y, w, h, r) => {
  r = Math.max(0, Math.min(r, w / 2, h));
  return `M${x},${y + h}V${y + r}Q${x},${y} ${x + r},${y}H${x + w - r}` +
         `Q${x + w},${y} ${x + w},${y + r}V${y + h}Z`;
};
const roundedRight = (x, y, w, h, r) => {
  r = Math.max(0, Math.min(r, w, h / 2));
  return `M${x},${y}H${x + w - r}Q${x + w},${y} ${x + w},${y + r}V${y + h - r}` +
         `Q${x + w},${y + h} ${x + w - r},${y + h}H${x}Z`;
};

function timeLabels(xs) {
  const span = Date.parse(xs[xs.length - 1]) - Date.parse(xs[0]);
  const sameDay = span < 20 * 3600 * 1000;
  return xs.map(x => {
    const iso = new Date(Date.parse(x)).toISOString();
    return sameDay ? iso.slice(11, 16) : iso.slice(5, 16).replace("T", " ");
  });
}

function prepare(card, measure) {
  const xName = card.xDim, sName = card.seriesDim;
  const series = sName ? card.series.slice() : [null];
  const grid = new Map(), totals = new Map();
  for (const row of card.rows) {
    const x = String(row[xName]);
    const s = sName ? String(row[sName]) : null;
    const v = Number(row[measure]);
    if (!Number.isFinite(v)) continue;
    if (!grid.has(x)) grid.set(x, new Map());
    grid.get(x).set(s, (grid.get(x).get(s) ?? 0) + v);
    totals.set(x, (totals.get(x) ?? 0) + v);
  }
  let xs = [...grid.keys()];
  if (card.xKind === "time") xs.sort((a, b) => Date.parse(a) - Date.parse(b));
  else if (card.xKind === "number") xs.sort((a, b) => Number(a) - Number(b));
  else xs.sort((a, b) => (totals.get(b) ?? 0) - (totals.get(a) ?? 0));
  const at = (x, s) => grid.get(x)?.get(s) ?? 0;
  return {xs, series, totals, at, stacked: series.length > 1};
}

function yAxis(svg, M, scale, y) {
  for (let v = 0; v <= scale.max + scale.step / 2; v += scale.step) {
    const yy = y(v);
    svg.appendChild(el("line", {
      x1: M.l, y1: yy, x2: W - M.r, y2: yy,
      stroke: v ? "var(--grid)" : "var(--axis)", "stroke-width": 1,
    }));
    svg.appendChild(svgText({x: M.l - 8, y: yy + 4, "text-anchor": "end"}, compact(v)));
  }
}

function showTip(event, title, entries) {
  tip.replaceChildren();
  tip.appendChild(html("h4", null, title));
  for (const entry of entries) {
    const row = html("div");
    const key = html("i");
    key.style.background = entry.color;
    row.append(key, html("b", null, compact(entry.value)));
    if (entry.label !== null) row.appendChild(html("s", null, entry.label));
    tip.appendChild(row);
  }
  tip.style.opacity = 1;
  tip.style.left = Math.min(event.clientX + 14, innerWidth - tip.offsetWidth - 8) + "px";
  tip.style.top = Math.min(event.clientY + 14, innerHeight - tip.offsetHeight - 8) + "px";
}
const hideTip = () => { tip.style.opacity = 0; };

function crosshair(svg, M, ih, data, xAt, labels) {
  const line = el("line", {y1: M.t, y2: M.t + ih, stroke: "var(--axis)", "stroke-width": 1, opacity: 0});
  svg.appendChild(line);
  const overlay = el("rect", {x: M.l, y: M.t, width: W - M.l - M.r, height: ih, fill: "transparent"});
  overlay.addEventListener("pointermove", event => {
    const box = svg.getBoundingClientRect();
    const px = ((event.clientX - box.left) / box.width) * W;
    let best = 0;
    data.xs.forEach((_, i) => {
      if (Math.abs(xAt(i) - px) < Math.abs(xAt(best) - px)) best = i;
    });
    const x = data.xs[best];
    line.setAttribute("x1", xAt(best));
    line.setAttribute("x2", xAt(best));
    line.setAttribute("opacity", 1);
    const entries = data.series
      .map((s, si) => ({label: s, color: seriesColor(si), value: data.at(x, s)}))
      .filter(entry => entry.value !== 0)
      .reverse();
    showTip(event, labels[best], entries.length ? entries : [{label: null, color: seriesColor(0), value: 0}]);
  });
  overlay.addEventListener("pointerleave", () => { hideTip(); line.setAttribute("opacity", 0); });
  svg.appendChild(overlay);
}

function drawColumns(card, svg, data) {
  const M = {t: 18, r: 28, b: 40, l: 68}, H = 380;
  const ih = H - M.t - M.b, iw = W - M.l - M.r;
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  const scale = axisScale(Math.max(...data.xs.map(x =>
    data.stacked ? data.totals.get(x) : Math.max(...data.series.map(s => data.at(x, s))))));
  const y = v => M.t + ih - (v / scale.max) * ih;
  yAxis(svg, M, scale, y);

  const band = iw / data.xs.length;
  const bw = Math.min(24, Math.max(2, band - 2));
  data.xs.forEach((x, i) => {
    const cx = M.l + band * (i + 0.5) - bw / 2;
    const cells = data.series
      .map((s, si) => ({s, si, v: data.at(x, s)}))
      .filter(cell => cell.v > 0);
    let cum = 0;
    cells.forEach((cell, idx) => {
      const y0 = y(cum), y1 = y(cum + cell.v);
      cum += cell.v;
      const h = Math.max(1, y0 - y1 - (idx ? 2 : 0));
      const top = idx === cells.length - 1;
      svg.appendChild(el(top ? "path" : "rect", top
        ? {d: roundedTop(cx, y1, bw, h, 4), fill: seriesColor(cell.si)}
        : {x: cx, y: y1, width: bw, height: h, fill: seriesColor(cell.si)}));
    });
  });

  const labels = card.xKind === "time" ? timeLabels(data.xs) : data.xs.map(String);
  const step = Math.ceil(data.xs.length / 8);
  labels.forEach((label, i) => {
    if (i % step) return;
    svg.appendChild(svgText(
      {x: M.l + band * (i + 0.5), y: H - 14, "text-anchor": "middle"}, label));
  });
  crosshair(svg, M, ih, data, i => M.l + band * (i + 0.5), labels);
}

function drawLines(card, svg, data) {
  const H = 380, M = {t: 18, r: 28, b: 40, l: 68}, ih = H - M.t - M.b;
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  const scale = axisScale(Math.max(...data.xs.flatMap(x => data.series.map(s => data.at(x, s)))));
  const y = v => M.t + ih - (v / scale.max) * ih;

  // End labels only earn their gutter when the series separate at the right edge;
  // nudging converged labels apart detaches them from their lines.
  const lastX = data.xs[data.xs.length - 1];
  const endYs = data.series.map(s => y(data.at(lastX, s))).sort((a, b) => a - b);
  const labelEnds = data.series.length > 1 && data.series.length <= 6 &&
    endYs.every((v, i) => i === 0 || v - endYs[i - 1] >= 14);
  if (labelEnds) M.r = 130;

  const iw = W - M.l - M.r;
  const xAt = i => M.l + (data.xs.length === 1 ? iw / 2 : (iw * i) / (data.xs.length - 1));
  yAxis(svg, M, scale, y);

  const ends = [];
  data.series.forEach((s, si) => {
    const points = data.xs.map((x, i) => `${xAt(i)},${y(data.at(x, s))}`).join(" ");
    if (data.series.length === 1) {
      svg.appendChild(el("path", {
        d: `M${M.l},${M.t + ih}L${points.replace(/ /g, "L")}L${xAt(data.xs.length - 1)},${M.t + ih}Z`,
        fill: seriesColor(si), "fill-opacity": 0.1,
      }));
    }
    svg.appendChild(el("polyline", {
      points, fill: "none", stroke: seriesColor(si), "stroke-width": 2,
      "stroke-linejoin": "round", "stroke-linecap": "round",
    }));
    ends.push({si, s, y: y(data.at(data.xs[data.xs.length - 1], s))});
  });

  if (labelEnds) {
    for (const end of ends) {
      svg.appendChild(svgText({
        x: xAt(data.xs.length - 1) + 8, y: end.y + 4, fill: "var(--text-secondary)",
      }, end.s));
    }
  }

  const labels = card.xKind === "time" ? timeLabels(data.xs) : data.xs.map(String);
  const step = Math.ceil(data.xs.length / 8);
  labels.forEach((label, i) => {
    if (i % step) return;
    svg.appendChild(svgText({x: xAt(i), y: H - 14, "text-anchor": "middle"}, label));
  });
  crosshair(svg, M, ih, data, xAt, labels);
}

function drawBars(card, svg, data) {
  const rowH = 26, M = {t: 8, r: 64, b: 8, l: 260};
  const H = M.t + M.b + rowH * data.xs.length;
  const iw = W - M.l - M.r;
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  const max = axisScale(Math.max(...data.xs.map(x => data.totals.get(x)))).max;
  data.xs.forEach((x, i) => {
    const v = data.totals.get(x);
    const bh = Math.min(24, rowH - 2);
    const yy = M.t + rowH * i + (rowH - bh) / 2;
    const w = Math.max(1, (v / max) * iw);
    const label = svgText({x: M.l - 10, y: yy + bh / 2 + 4, "text-anchor": "end",
                           fill: "var(--text-secondary)"}, x.length > 40 ? x.slice(0, 39) + "…" : x);
    label.appendChild(el("title")).textContent = x;
    svg.appendChild(label);
    svg.appendChild(el("path", {d: roundedRight(M.l, yy, w, bh, 4), fill: seriesColor(0)}));
    svg.appendChild(svgText({x: M.l + w + 8, y: yy + bh / 2 + 4, fill: "var(--text-secondary)"},
                            compact(v)));
    const hit = el("rect", {x: M.l, y: M.t + rowH * i, width: iw, height: rowH, fill: "transparent"});
    hit.addEventListener("pointermove", event =>
      showTip(event, x, [{label: null, color: seriesColor(0), value: v}]));
    hit.addEventListener("pointerleave", hideTip);
    svg.appendChild(hit);
  });
}

function drawHeatmap(card, svg, data) {
  const rowH = 24, M = {t: 8, r: 24, b: 64, l: 240};
  const H = M.t + M.b + rowH * data.series.length;
  const iw = W - M.l - M.r;
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  const cw = iw / data.xs.length;
  const max = Math.max(...data.xs.flatMap(x => data.series.map(s => data.at(x, s))));
  data.series.forEach((s, si) => {
    const label = svgText({x: M.l - 10, y: M.t + rowH * si + 16, "text-anchor": "end",
                           fill: "var(--text-secondary)"}, s.length > 34 ? s.slice(0, 33) + "…" : s);
    label.appendChild(el("title")).textContent = s;
    svg.appendChild(label);
    data.xs.forEach((x, xi) => {
      const v = data.at(x, s);
      const step = v <= 0 ? 0 : Math.min(7, Math.max(1, Math.ceil((v / max) * 7)));
      const cell = el("rect", {
        x: M.l + cw * xi + 1, y: M.t + rowH * si + 1,
        width: Math.max(1, cw - 2), height: rowH - 2, rx: 2,
        fill: step ? `var(--seq-${step})` : "var(--grid)",
      });
      cell.addEventListener("pointermove", event =>
        showTip(event, `${s} · ${x}`, [{label: null, color: `var(--seq-${step || 1})`, value: v}]));
      cell.addEventListener("pointerleave", hideTip);
      svg.appendChild(cell);
      if (cw >= 44 && v > 0) {
        svg.appendChild(svgText({
          x: M.l + cw * (xi + 0.5), y: M.t + rowH * si + 16, "text-anchor": "middle",
          fill: step >= 5 ? "#ffffff" : "var(--text-primary)",
        }, compact(v)));
      }
    });
  });
  data.xs.forEach((x, xi) => {
    const label = svgText({
      "text-anchor": "end", fill: "var(--text-secondary)",
      transform: `translate(${M.l + cw * (xi + 0.5) + 4},${H - M.b + 14}) rotate(-40)`,
    }, x.length > 14 ? x.slice(0, 13) + "…" : x);
    label.appendChild(el("title")).textContent = x;
    svg.appendChild(label);
  });
  return max;
}

function sequentialLegend(measure, max) {
  const legend = html("div", "legend");
  legend.append(html("span", null, measure + " 0"));
  for (let step = 1; step <= 7; step++) {
    const swatch = html("i");
    swatch.style.background = `var(--seq-${step})`;
    legend.appendChild(swatch);
  }
  legend.appendChild(html("span", null, compact(max)));
  return legend;
}

function drawTiles(card, host) {
  const tiles = html("div", "tiles");
  const row = card.rows[0] ?? {};
  for (const name of card.measures) {
    const tile = html("div");
    tile.append(html("div", "tile-label", name),
                html("div", "tile-value", Number.isFinite(Number(row[name]))
                  ? compact(Number(row[name])) : String(row[name] ?? "—")));
    tiles.appendChild(tile);
  }
  host.appendChild(tiles);
}

function buildLegend(card, data) {
  if (!card.seriesDim || data.series.length < 2) return null;
  const legend = html("div", "legend");
  data.series.forEach((s, si) => {
    const item = html("span");
    const key = html("i", card.form === "lines" ? "line" : null);
    key.style.background = seriesColor(si);
    item.append(key, html("span", null, s));
    legend.appendChild(item);
  });
  return legend;
}

function buildTable(card) {
  const wrap = html("div", "scroll");
  const table = html("table");
  const head = html("tr");
  for (const column of card.columns) {
    const th = html("th", column.kind === "number" ? "num" : null, column.name);
    head.appendChild(th);
  }
  table.appendChild(head);
  for (const row of card.rows.slice(0, ROW_LIMIT)) {
    const tr = html("tr");
    for (const column of card.columns) {
      const value = row[column.name];
      tr.appendChild(html("td", column.kind === "number" ? "num" : null,
        value === undefined || value === null ? "" :
        column.kind === "number" ? compact(Number(value)) : String(value)));
    }
    table.appendChild(tr);
  }
  wrap.appendChild(table);
  return wrap;
}

function renderCard(card) {
  const section = html("section", "card");
  const head = html("div", "card-head");
  head.appendChild(html("h2", null, card.name));
  const body = html("div");
  let measure = card.measures[0];

  const draw = () => {
    body.replaceChildren();
    if (card.form === "table") { body.appendChild(buildTable(card)); return; }
    if (card.form === "tiles") { drawTiles(card, body); return; }
    const data = prepare(card, measure);
    const svg = el("svg", {role: "img", "aria-label": `${card.name} — ${measure}`});
    body.appendChild(svg);
    let legend = null;
    if (card.form === "heatmap") legend = sequentialLegend(measure, drawHeatmap(card, svg, data));
    else {
      legend = buildLegend(card, data);
      if (card.form === "columns") drawColumns(card, svg, data);
      else if (card.form === "lines") drawLines(card, svg, data);
      else drawBars(card, svg, data);
    }
    if (legend) body.insertBefore(legend, svg);
    const details = html("details");
    details.appendChild(html("summary", null, `Table · ${card.rows.length} rows`));
    details.appendChild(buildTable(card));
    body.appendChild(details);
  };

  if (card.measures.length > 1 && card.form !== "tiles" && card.form !== "table") {
    const select = html("select");
    for (const name of card.measures) {
      const option = html("option", null, name);
      option.value = name;
      select.appendChild(option);
    }
    select.addEventListener("change", () => { measure = select.value; draw(); });
    head.appendChild(select);
  }
  if (card.note) head.appendChild(html("p", "note", card.note));
  section.append(head, body);
  draw();
  return section;
}

const meta = document.getElementById("meta");
for (const [name, value] of PAYLOAD.keyvalues) {
  const item = html("span");
  item.append(html("span", null, name + " "), html("b", null, value));
  meta.appendChild(item);
}
if (!PAYLOAD.cards.length && !PAYLOAD.keyvalues.length) {
  meta.appendChild(html("span", null, "nothing to show in this response"));
}
const host = document.getElementById("cards");
for (const card of PAYLOAD.cards) host.appendChild(renderCard(card));
</script>
</body>
</html>
"""


def main() -> None:
    args = parse_args()
    text = args.input.read_text(encoding="utf-8") if args.input else sys.stdin.read()
    document = build_document(parse_input(text))

    if args.output:
        output_path = args.output
    else:
        handle, name = tempfile.mkstemp(prefix="es-viz-", suffix=".html")
        os.close(handle)
        output_path = Path(name)

    output_path.write_text(render_html(document, args.title), encoding="utf-8")
    if not args.no_open:
        subprocess.run(["open", str(output_path)], check=False)
    print(output_path.resolve())


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
