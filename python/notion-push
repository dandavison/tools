#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = ["pycookiecheat>=0.8"]
# ///
"""Create a Notion page from Markdown on stdin, with no LLM in the loop.

Reads your Chrome `token_v2` session cookie (via pycookiecheat), creates an empty
subpage of the parent page, and hands the Markdown to Notion's private import API
(getUploadFileUrl/enqueueTask importFile), so Notion itself does the
Markdown-to-blocks conversion. This is the same conversion as the "Import >
Markdown" menu item, and the inverse of notion-fetch.

Usage:
  gh-issue-to-md 42 | notion-push [--parent <notion-url> | --page <notion-url>] [--title TITLE]

Prints the new page's URL. The title comes from --title, else the YAML
frontmatter `title`, else the first H1; frontmatter is dropped, as is a leading
H1 that supplied the title (Notion titles the page from the uploaded filename).

Notion's importer handles neither HTML nor local files, so before importing,
notion-push replaces these with marker paragraphs, and afterwards rewrites the
marked blocks:
- `<details><summary><h3>T</h3></summary> ... </details>` becomes a toggle
  heading (a plain `<summary>T</summary>` becomes a toggle).
- A line that is only `![alt](path)` or `[alt](path)`, where path is a local
  image or video file (relative to --base-dir), becomes an uploaded image or
  video block.
- With --render-d2, a ```d2 fenced block becomes an uploaded PNG rendered by
  d2-render.

Requires being logged into Notion in Chrome. The first run triggers a one-time
macOS Keychain prompt for "Chrome Safe Storage"; click "Always Allow".
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path
from typing import Any, NoReturn

from pycookiecheat import chrome_cookies

D2_RENDER = Path(__file__).resolve().with_name("d2-render")
MEDIA_TYPES = {
    ".png": ("image", "image/png"),
    ".jpg": ("image", "image/jpeg"),
    ".jpeg": ("image", "image/jpeg"),
    ".gif": ("image", "image/gif"),
    ".svg": ("image", "image/svg+xml"),
    ".mp4": ("video", "video/mp4"),
    ".webm": ("video", "video/webm"),
    ".mov": ("video", "video/quicktime"),
}

API = "https://www.notion.so/api/v3"
DEFAULT_PARENT = "https://www.notion.so/3c78fc567738803cb9d0f10ffeadfdbd"
UUID_RE = re.compile(
    r"[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}", re.IGNORECASE
)


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Create a Notion page from Markdown on stdin."
    )
    ap.add_argument("--parent", default=DEFAULT_PARENT, help="parent Notion page URL")
    ap.add_argument(
        "--page",
        help="existing Notion page URL whose content to replace (keeps its URL)",
    )
    ap.add_argument(
        "--title", help="page title (default: from frontmatter or first H1)"
    )
    ap.add_argument(
        "--profile", help='Chrome profile, e.g. "Profile 1" (default: Default)'
    )
    ap.add_argument("--timeout", type=int, default=180, help="import wait, seconds")
    ap.add_argument(
        "--base-dir",
        default=".",
        help="directory that local media paths are relative to",
    )
    ap.add_argument(
        "--render-d2", action="store_true", help="upload d2 blocks as rendered PNGs"
    )
    ap.add_argument(
        "--comment-last",
        metavar="TEXT",
        help="attach a comment to the page's last block",
    )
    args = ap.parse_args()

    markdown = sys.stdin.read()
    if not markdown.strip():
        die("no markdown on stdin")
    title, body = title_and_body(markdown, args.title)
    markers = Markers(f"NOTIONPUSH{uuid.uuid4().hex[:8]}")
    body = markers.mark_details(body)
    body = markers.mark_media(body, Path(args.base_dir), args.render_d2)
    body = unwrap_paragraphs(body)

    cookies = notion_cookies(args.profile)
    token = cookies["token_v2"]
    if args.page:
        page_id = extract_block_id(args.page)
        space_id = space_of(page_id, token)
        log(f"replacing content of page {page_id}")
    else:
        parent_id = extract_block_id(args.parent)
        space_id = space_of(parent_id, token)
        page_id = create_empty_subpage(parent_id, space_id, token)
        log(f"created page {page_id} under {parent_id}")
    import_markdown(page_id, space_id, title, body.encode(), token, args.timeout)
    rewrite_marked_blocks(page_id, space_id, markers, token)
    if args.comment_last:
        comment_on_last_block(
            page_id, space_id, args.comment_last, cookies["notion_user_id"], token
        )
    print(page_url(page_id))
    return 0


class Markers:
    """Marker paragraphs standing in for what the importer cannot handle."""

    def __init__(self, nonce: str) -> None:
        self.open = f"{nonce}OPEN"
        self.close = f"{nonce}CLOSE"
        self.media_prefix = f"{nonce}MEDIA"
        self.media: list[Path] = []
        self.rendered_dir = Path(tempfile.mkdtemp(prefix="notion-push-"))

    def mark_details(self, md: str) -> str:
        def open_toggle(m: re.Match[str]) -> str:
            heading = re.fullmatch(
                r"\s*<h([1-6])>(.*?)</h\1>\s*", m.group(1), re.DOTALL
            )
            if heading:
                level = min(int(heading.group(1)), 3)
                head = f"{'#' * level} {heading.group(2).strip()}"
            else:
                head = m.group(1).strip()
            return f"\n\n{self.open}\n\n{head}\n\n"

        md = re.sub(
            r"<details>\s*<summary>(.*?)</summary>", open_toggle, md, flags=re.DOTALL
        )
        return re.sub(r"</details>", f"\n\n{self.close}\n\n", md)

    def mark_media(self, md: str, base_dir: Path, render_d2: bool) -> str:
        if render_d2:
            md = re.sub(
                r"^```d2\n(.*?)^```[ \t]*$",
                self.render_d2_block,
                md,
                flags=re.DOTALL | re.MULTILINE,
            )
        return re.sub(
            r"^!?\[[^\]]*\]\(([^)\s]+)\)[ \t]*$",
            lambda m: self.media_marker(base_dir / m.group(1), m.group(0)),
            md,
            flags=re.MULTILINE,
        )

    def render_d2_block(self, m: re.Match[str]) -> str:
        png = self.rendered_dir / f"diagram-{len(self.media) + 1}.png"
        result = subprocess.run(
            [D2_RENDER, "--png"],
            input=m.group(1).encode(),
            capture_output=True,
            check=False,
        )
        if result.returncode != 0:
            die(f"d2-render failed: {result.stderr.decode(errors='replace')}")
        png.write_bytes(result.stdout)
        return self.media_marker(png, m.group(0))

    def media_marker(self, path: Path, original: str) -> str:
        if path.suffix.lower() not in MEDIA_TYPES or not path.is_file():
            return original
        self.media.append(path)
        return f"\n\n{self.media_prefix}{len(self.media) - 1}\n\n"


def title_and_body(markdown: str, override: str | None) -> tuple[str, str]:
    frontmatter, body = split_frontmatter(markdown)
    title = override or frontmatter.get("title") or first_heading(body) or "Untitled"
    return title, strip_leading_heading(body, title)


def split_frontmatter(markdown: str) -> tuple[dict[str, str], str]:
    if not markdown.startswith("---\n"):
        return {}, markdown
    end = markdown.find("\n---\n", 3)
    if end == -1:
        return {}, markdown
    fields = {}
    for line in markdown[4:end].splitlines():
        key, sep, value = line.partition(":")
        if sep:
            fields[key.strip()] = unquote(value.strip())
    return fields, markdown[end + 5 :].lstrip("\n")


def unquote(value: str) -> str:
    if value[:1] not in ('"', "'"):
        return value
    try:
        return json.loads(value)
    except ValueError:
        return value.strip("\"'")


def first_heading(body: str) -> str | None:
    match = re.match(r"\s*#\s+(.+)", body)
    return match.group(1).strip() if match else None


def strip_leading_heading(body: str, title: str) -> str:
    """Notion takes the page title from the uploaded filename, so a leading H1
    that says the same thing would render as a duplicate."""
    match = re.match(r"\s*#\s+(.+)\n?", body)
    if match and match.group(1).strip() == title:
        return body[match.end() :].lstrip("\n")
    return body


LIST_ITEM_RE = re.compile(r"^\s*([-*+]|\d+[.)])\s")


def unwrap_paragraphs(md: str) -> str:
    """Notion's importer renders a bare newline as a hard line break rather than a
    CommonMark soft wrap, so a paragraph or list item that's been word-wrapped
    across physical lines (for readable diffs) shows up as a stack of short,
    oddly-justified lines. Join such wrapped lines back onto the paragraph's or
    list item's own line, leaving blank lines, headings, blockquotes, tables, and
    fenced code untouched."""
    out: list[str] = []
    para: list[str] = []
    fenced = False

    def flush() -> None:
        if para:
            out.append(" ".join(para))
            para.clear()

    for line in md.split("\n"):
        if fenced:
            out.append(line)
            fenced ^= line.lstrip().startswith("```")
            continue
        if (
            line.lstrip().startswith("```")
            or not line.strip()
            or is_lone_block_start(line)
            or line.endswith("  ")
        ):
            flush()
            out.append(line)
            fenced ^= line.lstrip().startswith("```")
            continue
        if LIST_ITEM_RE.match(line):
            flush()
        para.append(line.strip())
    flush()
    return "\n".join(out)


def is_lone_block_start(line: str) -> bool:
    """Block starts that are always single physical lines, so unlike list items
    they never gain a merged continuation."""
    stripped = line.lstrip()
    return bool(
        stripped
        and (
            stripped.startswith(("#", ">", "|")) or re.match(r"[-*_]{3,}\s*$", stripped)
        )
    )


def notion_cookies(profile: str | None) -> dict[str, str]:
    cookie_file = None
    if profile:
        cookie_file = (
            Path.home()
            / "Library/Application Support/Google/Chrome"
            / profile
            / "Cookies"
        )
    cookies = chrome_cookies("https://www.notion.so", cookie_file=cookie_file)
    if not cookies.get("token_v2"):
        die(
            "no token_v2 cookie for www.notion.so; log into Notion in Chrome"
            + (f" ({profile})" if profile else "")
        )
    return cookies


def extract_block_id(url: str) -> str:
    ids = UUID_RE.findall(url.split("#", 1)[0])
    if not ids:
        die(f"no page id found in URL: {url}")
    raw = ids[-1].replace("-", "").lower()
    return f"{raw[0:8]}-{raw[8:12]}-{raw[12:16]}-{raw[16:20]}-{raw[20:32]}"


def space_of(block_id: str, token: str) -> str:
    resp = api_post(
        "syncRecordValues",
        {"requests": [{"pointer": {"table": "block", "id": block_id}, "version": -1}]},
        token,
    )
    block = unwrap(((resp.get("recordMap") or {}).get("block") or {}).get(block_id))
    if not block:
        die(f"parent page not found (or not visible to you): {block_id}")
    return block["space_id"]


def unwrap(rec: Any) -> dict[str, Any] | None:
    """Peel record wrappers ({spaceId/value/role: ...}) down to the record itself,
    which is the first nested dict carrying an ``id``."""
    while (
        isinstance(rec, dict) and "id" not in rec and isinstance(rec.get("value"), dict)
    ):
        rec = rec["value"]
    return rec if isinstance(rec, dict) and "id" in rec else None


def create_empty_subpage(parent_id: str, space_id: str, token: str) -> str:
    """The importer writes into a block that already exists, so make an empty one."""
    page_id = str(uuid.uuid4())
    pointer = {"table": "block", "id": page_id, "spaceId": space_id}
    api_post(
        "saveTransactions",
        {
            "requestId": str(uuid.uuid4()),
            "transactions": [
                {
                    "id": str(uuid.uuid4()),
                    "spaceId": space_id,
                    "operations": [
                        {
                            "pointer": pointer,
                            "path": [],
                            "command": "set",
                            "args": {"type": "page", "id": page_id, "version": 1},
                        },
                        {
                            "pointer": pointer,
                            "path": [],
                            "command": "update",
                            "args": {
                                "parent_id": parent_id,
                                "parent_table": "block",
                                "alive": True,
                            },
                        },
                        {
                            "pointer": {
                                "table": "block",
                                "id": parent_id,
                                "spaceId": space_id,
                            },
                            "path": ["content"],
                            "command": "listAfter",
                            "args": {"id": page_id},
                        },
                    ],
                }
            ],
        },
        token,
    )
    return page_id


def import_markdown(
    page_id: str, space_id: str, title: str, data: bytes, token: str, timeout_s: int
) -> None:
    file_name = f"{file_stem(title)}.md"
    upload = api_post(
        "getUploadFileUrl",
        {
            "bucket": "temporary",
            "name": file_name,
            "contentType": "text/markdown",
            "record": {"table": "block", "id": page_id, "spaceId": space_id},
        },
        token,
    )
    put(upload["signedPutUrl"], data, put_headers(upload), "text/markdown")
    task_id = api_post(
        "enqueueTask",
        {
            "task": {
                "eventName": "importFile",
                "request": {
                    "importType": "ReplaceBlock",
                    "fileURL": upload["url"],
                    "fileName": file_name,
                    "signedToken": upload["signedToken"],
                    "block": {"id": page_id, "spaceId": space_id},
                    "spaceId": space_id,
                    "userTimeZone": local_timezone(),
                    "flowId": str(uuid.uuid4()),
                    "importId": str(uuid.uuid4()),
                    "importInstanceId": str(uuid.uuid4()),
                    "importEntryPoint": "modal",
                },
            }
        },
        token,
    )["taskId"]
    log(f"import task {task_id} enqueued for {file_name}")
    poll_import(task_id, page_id, token, timeout_s)


def file_stem(title: str) -> str:
    """The filename becomes the page title, and also an S3 object key."""
    return re.sub(r"[\\/\s]+", " ", title).strip() or "Untitled"


def put(url: str, data: bytes, headers: dict[str, str], content_type: str) -> None:
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": content_type, **headers},
        method="PUT",
    )
    with urllib.request.urlopen(req, timeout=120) as resp:
        if resp.status != 200:
            die(f"upload failed: {resp.status}")


def poll_import(task_id: str, page_id: str, token: str, timeout_s: int) -> None:
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        results = (
            api_post("getTasks", {"taskIds": [task_id]}, token).get("results") or []
        )
        if not results:
            die(f"task {task_id} not found")
        task = results[0]
        state = task.get("state")
        if state == "success":
            return
        if state == "failure":
            die(
                f"import failed: {json.dumps(task.get('error') or task.get('status'))}"
                f" (empty page left at {page_url(page_id)})"
            )
        log(f"  state={state}")
        time.sleep(2)
    die(f"import timed out after {timeout_s}s")


def rewrite_marked_blocks(
    page_id: str, space_id: str, markers: Markers, token: str
) -> None:
    child_ids = load_blocks([page_id], token)[page_id].get("content") or []
    blocks = load_blocks(child_ids, token)
    ops: list[dict[str, Any]] = []
    toggles: list[str] = []  # open toggle heads, innermost last
    expect_head = False
    for block_id in child_ids:
        text = block_text(blocks[block_id])
        pointer = {"table": "block", "id": block_id, "spaceId": space_id}
        if text in (markers.open, markers.close):
            if text == markers.open:
                expect_head = True
            elif toggles:
                toggles.pop()
            ops += remove_ops(pointer, page_id, space_id)
            continue
        if text.startswith(markers.media_prefix):
            # Notion rejects edits to an imported block's properties, so the media
            # block is a new one, placed where the marker was.
            path = markers.media[int(text.removeprefix(markers.media_prefix))]
            parent = toggles[-1] if toggles else page_id
            after = block_id if parent == page_id else None
            ops += media_ops(path, page_id, parent, after, space_id, token)
            ops += remove_ops(pointer, page_id, space_id)
            continue
        if toggles:
            ops += move_ops(pointer, page_id, toggles[-1], space_id)
        if expect_head:
            ops.append(make_toggle(pointer, blocks[block_id]))
            toggles.append(block_id)
            expect_head = False
    for i in range(0, len(ops), 200):
        save(ops[i : i + 200], space_id, token)


def comment_on_last_block(
    page_id: str, space_id: str, text: str, user_id: str, token: str
) -> None:
    content = load_blocks([page_id], token)[page_id].get("content") or []
    if not content:
        die("cannot comment: the page is empty")
    block_id = content[-1]
    discussion_id = str(uuid.uuid4())
    comment_id = str(uuid.uuid4())
    now = int(time.time() * 1000)
    save(
        [
            {
                "pointer": {
                    "table": "discussion",
                    "id": discussion_id,
                    "spaceId": space_id,
                },
                "path": [],
                "command": "set",
                "args": {
                    "id": discussion_id,
                    "version": 1,
                    "parent_id": block_id,
                    "parent_table": "block",
                    "resolved": False,
                    "comments": [comment_id],
                    "space_id": space_id,
                    "type": "default",
                    "nav_parent_table": "block",
                    "nav_parent_id": page_id,
                },
            },
            {
                "pointer": {"table": "comment", "id": comment_id, "spaceId": space_id},
                "path": [],
                "command": "set",
                "args": {
                    "id": comment_id,
                    "version": 1,
                    "parent_id": discussion_id,
                    "parent_table": "discussion",
                    "text": [[text]],
                    "created_by_id": user_id,
                    "created_by_table": "notion_user",
                    "created_time": now,
                    "last_edited_time": now,
                    "alive": True,
                    "space_id": space_id,
                },
            },
            {
                "pointer": {"table": "block", "id": block_id, "spaceId": space_id},
                "path": ["discussions"],
                "command": "listAfter",
                "args": {"id": discussion_id},
            },
        ],
        space_id,
        token,
    )
    log(f"commented on block {block_id}")


def load_blocks(block_ids: list[str], token: str) -> dict[str, dict[str, Any]]:
    blocks: dict[str, dict[str, Any]] = {}
    for i in range(0, len(block_ids), 100):
        batch = block_ids[i : i + 100]
        resp = api_post(
            "syncRecordValues",
            {
                "requests": [
                    {"pointer": {"table": "block", "id": b}, "version": -1}
                    for b in batch
                ]
            },
            token,
        )
        records = (resp.get("recordMap") or {}).get("block") or {}
        for b in batch:
            block = unwrap(records.get(b))
            if not block:
                die(f"block not found: {b}")
            blocks[b] = block
    return blocks


def block_text(block: dict[str, Any]) -> str:
    title = (block.get("properties") or {}).get("title") or []
    return "".join(chunk[0] for chunk in title if chunk).strip()


def remove_ops(
    pointer: dict[str, str], parent_id: str, space_id: str
) -> list[dict[str, Any]]:
    return [
        {"pointer": pointer, "path": [], "command": "update", "args": {"alive": False}},
        {
            "pointer": {"table": "block", "id": parent_id, "spaceId": space_id},
            "path": ["content"],
            "command": "listRemove",
            "args": {"id": pointer["id"]},
        },
    ]


def move_ops(
    pointer: dict[str, str], old_parent: str, new_parent: str, space_id: str
) -> list[dict[str, Any]]:
    return [
        {
            "pointer": {"table": "block", "id": old_parent, "spaceId": space_id},
            "path": ["content"],
            "command": "listRemove",
            "args": {"id": pointer["id"]},
        },
        {
            "pointer": pointer,
            "path": [],
            "command": "update",
            "args": {"parent_id": new_parent, "parent_table": "block"},
        },
        {
            "pointer": {"table": "block", "id": new_parent, "spaceId": space_id},
            "path": ["content"],
            "command": "listAfter",
            "args": {"id": pointer["id"]},
        },
    ]


def make_toggle(pointer: dict[str, str], block: dict[str, Any]) -> dict[str, Any]:
    if block.get("type") in ("header", "sub_header", "sub_sub_header"):
        return {
            "pointer": pointer,
            "path": ["format"],
            "command": "update",
            "args": {"toggleable": True},
        }
    return {
        "pointer": pointer,
        "path": [],
        "command": "update",
        "args": {"type": "toggle"},
    }


def media_ops(
    path: Path,
    page_id: str,
    parent_id: str,
    after: str | None,
    space_id: str,
    token: str,
) -> list[dict[str, Any]]:
    block_type, content_type = MEDIA_TYPES[path.suffix.lower()]
    upload = api_post(
        "getUploadFileUrl",
        {
            "bucket": "secure",
            "name": path.name,
            "contentType": content_type,
            "record": {"table": "block", "id": page_id, "spaceId": space_id},
        },
        token,
    )
    put(upload["signedPutUrl"], path.read_bytes(), put_headers(upload), content_type)
    log(f"uploaded {path.name}")
    url = upload["url"]
    block_id = str(uuid.uuid4())
    return [
        {
            "pointer": {"table": "block", "id": block_id, "spaceId": space_id},
            "path": [],
            "command": "set",
            "args": {
                "type": block_type,
                "id": block_id,
                "version": 1,
                "properties": {"source": [[url]]},
                "format": {"display_source": url},
                "file_ids": [file_id_of(url)],
                "parent_id": parent_id,
                "parent_table": "block",
                "alive": True,
                "space_id": space_id,
            },
        },
        {
            "pointer": {"table": "block", "id": parent_id, "spaceId": space_id},
            "path": ["content"],
            "command": "listAfter",
            "args": {"id": block_id, **({"after": after} if after else {})},
        },
    ]


def put_headers(upload: dict[str, Any]) -> dict[str, str]:
    """putHeaders comes back as a list of {name, value}."""
    return {h["name"]: h["value"] for h in upload.get("putHeaders") or []}


def file_id_of(url: str) -> str:
    ids = UUID_RE.findall(url)
    if not ids:
        die(f"no file id in upload URL: {url}")
    return ids[-1]


def save(ops: list[dict[str, Any]], space_id: str, token: str) -> None:
    api_post(
        "saveTransactions",
        {
            "requestId": str(uuid.uuid4()),
            "transactions": [
                {"id": str(uuid.uuid4()), "spaceId": space_id, "operations": ops}
            ],
        },
        token,
    )


def page_url(page_id: str) -> str:
    return f"https://www.notion.so/{page_id.replace('-', '')}"


def api_post(path: str, body: dict[str, Any], token: str) -> dict[str, Any]:
    req = urllib.request.Request(
        f"{API}/{path}",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "Cookie": f"token_v2={token}"},
        method="POST",
    )
    for attempt in range(6):
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                raw = resp.read()
                return json.loads(raw) if raw else {}
        except urllib.error.HTTPError as e:
            if e.code == 429 and attempt < 5:
                log(f"rate limited on {path}; retrying")
                time.sleep(2**attempt * 5)
                continue
            error = e
            break
    die(
        f"POST {path} -> {error.code} {error.reason}: "
        f"{error.read().decode(errors='replace')[:500]}"
    )


def local_timezone() -> str:
    link = Path("/etc/localtime")
    if link.is_symlink():
        target = os.readlink(link)
        if "zoneinfo/" in target:
            return target.split("zoneinfo/", 1)[1]
    return "UTC"


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def die(msg: str) -> NoReturn:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    sys.exit(main())
