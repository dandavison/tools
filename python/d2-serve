# ///
"""Serve SVG renders of d2 source, for the chrome-etc extension's GitHub code blocks."""

import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = 7119
D2_RENDER = Path(__file__).resolve().with_name("d2-render")


class Handler(BaseHTTPRequestHandler):
    def do_POST(self) -> None:
        source = self.rfile.read(int(self.headers.get("Content-Length", 0))).decode()
        result = render(source)
        if result.returncode == 0:
            self.respond(200, "image/svg+xml", result.stdout)
        else:
            self.respond(422, "text/plain", result.stderr)

    def respond(self, status: int, content_type: str, body: str) -> None:
        encoded = body.encode()
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)


def render(source: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [D2_RENDER], input=source, capture_output=True, text=True, check=False
    )


def main() -> None:
    print(f"d2 render service on http://127.0.0.1:{PORT}")
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


if __name__ == "__main__":
    main()
